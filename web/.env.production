# 배포 빌드 설정 (Amplify + EC2 분리 배포용).
#
# 이 배포는 프론트(Amplify)와 백엔드(EC2)가 오리진이 다르다 — 팀원의
# 단일-EC2 배포(원래 이 파일이 쓰던 방식, 빈 값=상대경로)와는 다르다.
# 그래서 절대주소가 필요하다. Amplify는 항상 HTTPS라 브라우저의 Mixed
# Content 차단을 피하려고, EC2(HTTP만 열림) 앞에 CloudFront를 붙여
# HTTPS로 감쌌다. CORS는 server/app/main.py 의 CORS_ORIGINS 에서 허용.
VITE_API_BASE=https://dk4duj9uogdeu.cloudfront.net

# 데모(목업) 모드를 켠 채로 배포한다.
# 0 으로 바꾸면 A/B 테스트·설정·크레딧 화면이 전부 404 로 죽는다 —
# 그 엔드포인트들은 아직 서버에 없다.
VITE_MOCK=1

# 실행을 진짜 파이프라인에 맡기지 않는다.
#
# .env.production 은 .env.local 을 **덮어쓰지 않고 합친다.** 여기서 명시하지
# 않으면 로컬 개발자의 .env.local 에 있는 VITE_LIVE_RUN=1 이 그대로 배포
# 번들에 실려서, 방문자 브라우저가 있지도 않은 파이프라인을 부르게 된다.
# 배포본은 이미 돌려 둔 실행을 재생한다.
VITE_LIVE_RUN=0
